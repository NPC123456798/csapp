.pos 0
irmovq stack, %rsp # set stack pointer
call main # call main function
halt # stop program


.align 8
ele1:
    .quad 0x00a
    .quad ele2
ele2:
    .quad 0x0b0
    .quad ele3
ele3:
    .quad 0xc00
    .quad 0


main:
    irmovq ele1, %rdi  #load address of first element into %rdi
    call rsum_list # 
    ret # return


rsum_list:
    xorq %rax, %rax # sum = 0
    jmp test

loop:
    mrmovq (%rdi), %r10 
    pushq %r10 # save current element on stack
    mrmovq 8(%rdi), %rdi # 
    call test  
    popq %r10 # restore current element from stack
    addq %r10, %rax # sum += *start
    ret

test:
    andq %rdi, %rdi # set condition code
    jne loop # if %rdi != 0, continue loop
    ret # return

# Stack starts here and grows to lower addresses
	.pos 0x200
stack:
