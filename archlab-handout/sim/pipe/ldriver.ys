#######################################################################
# Test for copying block of size 63;
#######################################################################
	.pos 0
main:	irmovq Stack, %rsp  	# Set up stack pointer

	# Set up arguments for copy function and then invoke it
	irmovq $63, %rdx		# src and dst have 63 elements
	irmovq dest, %rsi	# dst array
	irmovq src, %rdi	# src array
	call ncopy		 
	halt			# should halt with num nonzeros in %rax
StartFun:
# NPC123456798
#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header


	iaddq $-8, %rdx		# len -= 8
	jl handle_remainder	# if so, goto handle_remainder:

Loop_8_registers:	
	mrmovq (%rdi), %r8
    mrmovq 8(%rdi), %r9
    mrmovq 16(%rdi), %r10
    mrmovq 24(%rdi), %r11
    mrmovq 32(%rdi), %r12
    mrmovq 40(%rdi), %r13
    mrmovq 48(%rdi), %r14
    mrmovq 56(%rdi), %rcx


judge_first_8_registers:
    rmmovq %r9, 8(%rsi)	# ...and store
	xorq %r8, %r9		# val <= 0?
	rmmovq %r8, (%rsi)	# ...and store it to dst
	jl judge_second_8_registers	# if so, goto judge_second_8_registers:
    andq %r8, %r8		
    jle judge_third_8_registers	# if so, goto judge_third_8_registers:
	iaddq $2, %rax		# count++
    jmp judge_third_8_registers	# goto judge_third_8_registers:

judge_second_8_registers:
	
	iaddq $1, %rax		# count++

judge_third_8_registers:
    rmmovq %r11, 24(%rsi)	# ...and store
	xorq %r10, %r11		# val <= 0?
	rmmovq %r10, 16(%rsi)	# ...and store
	jl judge_fourth_8_registers	# if so, goto judge_fourth_8_registers:
    andq %r10, %r10		
    jle judge_fifth_8_registers	# if so, goto judge_fifth_8_registers:
	iaddq $2, %rax		# count++
    jmp judge_fifth_8_registers	# goto judge_fifth_8_registers:

judge_fourth_8_registers:
	iaddq $1, %rax		# count++

judge_fifth_8_registers:
	rmmovq %r13, 40(%rsi)	# ...and store		
	xorq %r12, %r13		# val <= 0?
	rmmovq %r12, 32(%rsi)	# ...and store
	jl judge_sixth_8_registers	# if so, goto judge_sixth_8_registers:
    andq %r12, %r12		
    jle judge_seventh_8_registers	# if so, goto judge_seventh_8_registers:
	iaddq $2, %rax		# count++
    jmp judge_seventh_8_registers	# goto judge_seventh_8_registers:

judge_sixth_8_registers:

	iaddq $1, %rax		# count++
judge_seventh_8_registers:
	rmmovq %rcx, 56(%rsi)	# ...and store
	xorq %r14, %rcx		# val <= 0?
	rmmovq %r14, 48(%rsi)	# ...and store
	jl judge_eighth_8_registers	# if so, goto judge_eighth_8_registers:
    andq %r14, %r14		
    jle Npos	# if so, goto Done:
	iaddq $2, %rax		# count++
    jmp Npos	# goto Done:
judge_eighth_8_registers:
	iaddq $1, %rax		# count++




Npos:	
	
	iaddq 64, %rdi		# src += 8
	iaddq 64, %rsi		# dst += 8
	iaddq $-8, %rdx		# len -= 8

	jge Loop_8_registers		# if so, goto Loop: use ge to make len % 8 == 0 case work




handle_remainder:
    
    # 二叉树找余数
    iaddq $4, %rdx        # 先减 4
    jl  case_l_0_3

    
	
case_ge4:
    iaddq $-2, %rdx
    jge  case_ge6
    iaddq $1, %rdx
	mrmovq 32(%rdi), %r8
    je   rem5
	mrmovq 24(%rdi), %r8
    jmp  rem4
    
case_l_0_3:
	iaddq $2, %rdx        # 直接减 2
	jl  case_l_0_1
    
	mrmovq 8(%rdi), %r8
    je  rem2
	mrmovq 16(%rdi), %r8
    jmp   rem3

case_l_0_1:
	iaddq $1, %rdx
	mrmovq (%rdi), %r8
	je   rem1
	ret


case_ge6:
	mrmovq 40(%rdi), %r8
    je  rem6
   
	mrmovq 48(%rdi), %r8
    jmp   rem7



# fall-through
rem7:
    andq %r8, %r8
    rmmovq %r8, 48(%rsi)
    mrmovq 40(%rdi), %r8
    jle   rem6
    iaddq $1, %rax
rem6:
    andq %r8, %r8
    rmmovq %r8, 40(%rsi)
    mrmovq 32(%rdi), %r8
    jle   rem5
    iaddq $1, %rax
rem5:
    andq %r8, %r8
    rmmovq %r8, 32(%rsi)
    mrmovq 24(%rdi), %r8
    jle   rem4
    iaddq $1, %rax
rem4:
    andq %r8, %r8
    rmmovq %r8, 24(%rsi)
    mrmovq 16(%rdi), %r8
    jle   rem3
    iaddq $1, %rax
rem3:
    andq %r8, %r8
    rmmovq %r8, 16(%rsi)
    mrmovq 8(%rdi), %r8
    jle   rem2
    iaddq $1, %rax
rem2:
    andq %r8, %r8
    rmmovq %r8, 8(%rsi)
    mrmovq (%rdi), %r8
    jle   rem1
    iaddq $1, %rax
rem1:
    andq %r8, %r8
    rmmovq %r8, (%rsi)
    jle   Done
    iaddq $1, %rax


##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
EndFun:

