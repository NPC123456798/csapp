#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
	xorq %rax,%rax		# count = 0;
	andq %rdx,%rdx		# len <= 0?
	irmovq $7, %rbx
	andq %rdx, %rbx		# len % 8
	iaddq $-8, %rdx		# len -= 8
	jl handle_remainder	# if so, goto handle_remainder:

	andq %rbx, %rbx	# i = 0
	jne Loop_8_registers	# if so, goto Loop_8_registers:
	iaddq $8, %rdx
	jle Done		# if so, goto Done:

Loop_8_registers:	
	mrmovq (%rdi), %r8
    mrmovq 8(%rdi), %r9
    mrmovq 16(%rdi), %r10
    mrmovq 24(%rdi), %r11
    mrmovq 32(%rdi), %r12
    mrmovq 40(%rdi), %r13
    mrmovq 48(%rdi), %r14
    mrmovq 56(%rdi), %rcx


judge_first_8_registers:
	andq %r8, %r8		# val <= 0?
	rmmovq %r8, (%rsi)	# ...and store it to dst
	jle judge_second_8_registers	# if so, goto judge_second_8_registers:
	iaddq $1, %rax		# count++

judge_second_8_registers:
	andq %r9, %r9		# val <= 0?
	rmmovq %r9, 8(%rsi)	# ...and store
	jle judge_third_8_registers	# if so, goto judge_third_8_registers:
	iaddq $1, %rax		# count++

judge_third_8_registers:
	andq %r10, %r10		# val <= 0?
	rmmovq %r10, 16(%rsi)	# ...and store
	jle judge_fourth_8_registers	# if so, goto judge_fourth_8_registers:
	iaddq $1, %rax		# count++

judge_fourth_8_registers:
	andq %r11, %r11		# val <= 0?
	rmmovq %r11, 24(%rsi)	# ...and store
	jle judge_fifth_8_registers	# if so, goto judge_fifth_8_registers:
	iaddq $1, %rax		# count++

judge_fifth_8_registers:
	andq %r12, %r12		# val <= 0?
	rmmovq %r12, 32(%rsi)	# ...and store
	jle judge_sixth_8_registers	# if so, goto judge_sixth_8_registers:
	iaddq $1, %rax		# count++

judge_sixth_8_registers:
	andq %r13, %r13		# val <= 0?
	rmmovq %r13, 40(%rsi)	# ...and store		
	jle judge_seventh_8_registers	# if so, goto judge_seventh_8_registers:
	iaddq $1, %rax		# count++
judge_seventh_8_registers:
	andq %r14, %r14		# val <= 0?
	rmmovq %r14, 48(%rsi)	# ...and store
	jle judge_eighth_8_registers	# if so, goto judge_eighth_8_registers:
	iaddq $1, %rax		# count++
judge_eighth_8_registers:
	andq %rcx, %rcx		# val <= 0?
	rmmovq %rcx, 56(%rsi)	# ...and store
	jle Npos	# if so, goto Loop_8_registers:
	iaddq $1, %rax		# count++




Npos:	
	
	iaddq 64, %rdi		# src += 8
	iaddq 64, %rsi		# dst += 8
	iaddq $-8, %rdx		# len -= 8
	andq %rdx,%rdx		# len > 0?
	jg Loop_8_registers		# if so, goto Loop:




handle_remainder:
    andq %rbx, %rbx
    je   Done

    # 二叉树找余数
    iaddq $-4, %rbx        # 先减 4
    jge  case_ge4
	
    # 余数 0-3
    iaddq $2, %rbx        # 直接减 2
    jge  case_ge2_0_3
	mrmovq (%rdi), %r8
    jmp   rem1
    
case_ge2_0_3:
    iaddq $-1, %rbx
	mrmovq 16(%rdi), %r8
    je   rem3
	mrmovq 8(%rdi), %r8
    jmp  rem2

case_ge4:
    iaddq $-2, %rbx
    jge  case_ge6
    iaddq $1, %rbx
	mrmovq 32(%rdi), %r8
    je   rem5
	mrmovq 24(%rdi), %r8
    jmp  rem4

case_ge6:
    iaddq $-1, %rbx
	mrmovq 48(%rdi), %r8
    je   rem7
	mrmovq 40(%rdi), %r8
    jmp  rem6
##################################################################
# fall-through 结构：大数字先执行，自然落到小数字
##################################################################
rem7:
    andq %r8, %r8
    rmmovq %r8, 48(%rsi)
    mrmovq 40(%rdi), %r8
    jle   rem6
    iaddq $1, %rax
rem6:
    andq %r8, %r8
    rmmovq %r8, 40(%rsi)
    mrmovq 32(%rdi), %r8
    jle   rem5
    iaddq $1, %rax
rem5:
    andq %r8, %r8
    rmmovq %r8, 32(%rsi)
    mrmovq 24(%rdi), %r8
    jle   rem4
    iaddq $1, %rax
rem4:
    andq %r8, %r8
    rmmovq %r8, 24(%rsi)
    mrmovq 16(%rdi), %r8
    jle   rem3
    iaddq $1, %rax
rem3:
    andq %r8, %r8
    rmmovq %r8, 16(%rsi)
    mrmovq 8(%rdi), %r8
    jle   rem2
    iaddq $1, %rax
rem2:
    andq %r8, %r8
    rmmovq %r8, 8(%rsi)
    mrmovq (%rdi), %r8
    jle   rem1
    iaddq $1, %rax
rem1:
    andq %r8, %r8
    rmmovq %r8, (%rsi)
    jle   rem0
    iaddq $1, %rax
rem0:
    jmp Done

##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
