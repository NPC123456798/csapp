#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
	xorq %rax,%rax		# count = 0;
	andq %rdx,%rdx		# len <= 0?
	irmovq $7, %rbx
	andq %rdx, %rbx		# len % 8
	iaddq $-8, %rdx		# len -= 8
	jl handle_remainder	# if so, goto handle_remainder:

	andq %rbx, %rbx	# i = 0
	jne Loop_8_registers	# if so, goto Loop_8_registers:
	iaddq $8, %rdx
	jle Done		# if so, goto Done:

Loop_8_registers:	
	mrmovq (%rdi), %r8
    mrmovq 8(%rdi), %r9
    mrmovq 16(%rdi), %r10
    mrmovq 24(%rdi), %r11
    mrmovq 32(%rdi), %r12
    mrmovq 40(%rdi), %r13
    mrmovq 48(%rdi), %r14
    mrmovq 56(%rdi), %rcx


judge_first_8_registers:
	andq %r8, %r8		# val <= 0?
	rmmovq %r8, (%rsi)	# ...and store it to dst
	jle judge_second_8_registers	# if so, goto judge_second_8_registers:
	iaddq $1, %rax		# count++

judge_second_8_registers:
	andq %r9, %r9		# val <= 0?
	rmmovq %r9, 8(%rsi)	# ...and store
	jle judge_third_8_registers	# if so, goto judge_third_8_registers:
	iaddq $1, %rax		# count++

judge_third_8_registers:
	andq %r10, %r10		# val <= 0?
	rmmovq %r10, 16(%rsi)	# ...and store
	jle judge_fourth_8_registers	# if so, goto judge_fourth_8_registers:
	iaddq $1, %rax		# count++

judge_fourth_8_registers:
	andq %r11, %r11		# val <= 0?
	rmmovq %r11, 24(%rsi)	# ...and store
	jle judge_fifth_8_registers	# if so, goto judge_fifth_8_registers:
	iaddq $1, %rax		# count++

judge_fifth_8_registers:
	andq %r12, %r12		# val <= 0?
	rmmovq %r12, 32(%rsi)	# ...and store
	jle judge_sixth_8_registers	# if so, goto judge_sixth_8_registers:
	iaddq $1, %rax		# count++

judge_sixth_8_registers:
	andq %r13, %r13		# val <= 0?
	rmmovq %r13, 40(%rsi)	# ...and store		
	jle judge_seventh_8_registers	# if so, goto judge_seventh_8_registers:
	iaddq $1, %rax		# count++
judge_seventh_8_registers:
	andq %r14, %r14		# val <= 0?
	rmmovq %r14, 48(%rsi)	# ...and store
	jle judge_eighth_8_registers	# if so, goto judge_eighth_8_registers:
	iaddq $1, %rax		# count++
judge_eighth_8_registers:
	andq %rcx, %rcx		# val <= 0?
	rmmovq %rcx, 56(%rsi)	# ...and store
	jle Npos	# if so, goto Loop_8_registers:
	iaddq $1, %rax		# count++




Npos:	
	
	iaddq 64, %rdi		# src += 8
	iaddq 64, %rsi		# dst += 8
	iaddq $-8, %rdx		# len -= 8
	andq %rdx,%rdx		# len > 0?
	jg Loop_8_registers		# if so, goto Loop:





##################################################################
# 优化后的余数处理（无循环，完全展开）
# %rbx = len % 8（0 到 7）
##################################################################
handle_remainder:
    andq %rbx, %rbx      # 余数为 0？
    je   Done

    # 判断余数并跳转到对应标签
    irmovq $1, %r10
    subq %r10, %rbx
    je   rem1
    subq %r10, %rbx
    je   rem2
    subq %r10, %rbx
    je   rem3
    subq %r10, %rbx
    je   rem4
    subq %r10, %rbx
    je   rem5
    subq %r10, %rbx
    je   rem6
    # 剩余 7 个
    jmp  rem7

##################################################################
# 每个 remX 标签处理对应数量的元素
# 从高到低排列，实现 fall-through 自动执行更少的元素
##################################################################
rem7:
    mrmovq 48(%rdi), %rcx
    rmmovq %rcx, 48(%rsi)
    andq %rcx, %rcx
    jle   rem6
    iaddq $1, %rax
rem6:
    mrmovq 40(%rdi), %rcx
    rmmovq %rcx, 40(%rsi)
    andq %rcx, %rcx
    jle   rem5
    iaddq $1, %rax
rem5:
    mrmovq 32(%rdi), %rcx
    rmmovq %rcx, 32(%rsi)
    andq %rcx, %rcx
    jle   rem4
    iaddq $1, %rax
rem4:
    mrmovq 24(%rdi), %rcx
    rmmovq %rcx, 24(%rsi)
    andq %rcx, %rcx
    jle   rem3
    iaddq $1, %rax
rem3:
    mrmovq 16(%rdi), %rcx
    rmmovq %rcx, 16(%rsi)
    andq %rcx, %rcx
    jle   rem2
    iaddq $1, %rax
rem2:
    mrmovq 8(%rdi), %rcx
    rmmovq %rcx, 8(%rsi)
    andq %rcx, %rcx
    jle   rem1
    iaddq $1, %rax
rem1:
    mrmovq (%rdi), %rcx
    rmmovq %rcx, (%rsi)
    andq %rcx, %rcx
    jle   done_remainder
    iaddq $1, %rax

done_remainder:
    jmp Done

##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
